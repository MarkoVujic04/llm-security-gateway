# App
APP_NAME="LLM Security Gateway"
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+psycopg://your_db_user:your_db_password@localhost:5432/your_db_name

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
# Comma separated API keys accepted by the gateway
API_KEYS=replace-with-your-own-key-1,replace-with-your-own-key-2
# Secret used to sign JWTs, generate a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# LLM provider
# Local LLM judge via LM Studio (OpenAI-compatible server)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Only needed if you use the cloud OpenAI/OpenRouter provider
OPENAI_API_KEY=

ENABLE_ADAPTIVE_DETECTION=true